{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dropship",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Daily Walmart stock checks, 13:00 UTC (8-9 AM US Eastern).
  "triggers": {
    "crons": ["0 13 * * *"]
  },

  // Products checked per daily run. Each check uses one SerpApi search
  // (two the first time for a product without a Walmart URL).
  "vars": {
    "STOCK_CHECKS_PER_RUN": "7"
  },

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sourcematch-db",
      "database_id": "2811c4c3-e068-4f93-9e2a-a6a98176d63e"
    }
  ]
}
